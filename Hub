local function updateProgress(text, progress, percentage)
    StatusLabel.Text = text
    if percentage then
        PercentageLabel.Text = percentage
    else
        PercentageLabel.Text = math.floor(progress * 100) .. "%"
    end
    
    TweenService:Create(ProgressBar, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(progress, 0, 1, 0)
    }):Play()
    
    ProgressGlow.Visible = progress > 0.1
    TweenService:Create(ProgressGlow, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(progress + 0.02, 0, 1, 0)
    }):Play()
end

-- Animasi Border Berkedip (Neon Pulse)
